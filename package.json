{
  "name": "reactjs-cv",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/material": "^9.0.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lodash": "^4.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.17.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "all": "npm run build && firebase deploy",
    "preview": "vite preview",
    "lint": "eslint \"{src,tests}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{src,tests}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,json,css,scss,md}\" \"*.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest --config vitest.unit.config.ts",
    "test:unit:run": "vitest run --config vitest.unit.config.ts",
    "test:run": "npm run test:unit:run",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:automation": "playwright test",
    "test:automation:headed": "playwright test --headed",
    "test:automation:debug": "playwright test --debug",
    "test:automation:ui": "playwright test --ui",
    "test:automation:install": "playwright install",
    "test:all": "npm run test:unit:run && npm run test:automation",
    "upload:cv": "node scripts/upload-cv.mjs",
    "update:localization": "node scripts/update-localization.mjs",
    "upload:project": "node scripts/upload-user-data.mjs --doc=project",
    "upload:payment": "node scripts/upload-user-data.mjs --doc=payment",
    "upload:certificate": "node scripts/upload-user-data.mjs --doc=certificate",
    "upload:education": "node scripts/upload-user-data.mjs --doc=education",
    "upload:experience": "node scripts/upload-user-data.mjs --doc=experience",
    "upload:skill": "node scripts/upload-user-data.mjs --doc=skill",
    "upload:contact": "node scripts/upload-user-data.mjs --doc=contact",
    "upload:service": "node scripts/upload-user-data.mjs --doc=service",
    "prepare": "husky install"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260606.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.19.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{src,tests}/**/*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
