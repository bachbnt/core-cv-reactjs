rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio data: anyone can read, nobody can write from client
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /user/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Contact form: anyone can submit, nobody can read submissions from client
    match /message/{document} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000;
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
